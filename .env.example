# Copy to .env for local development. Never commit .env.
# Every secret is read from the environment; nothing is hard-coded.

# ---- backend --------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite for local development (file lives in ./data). In production use the
# Neon pooled connection string, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=sqlite:///./data/patients.db

# Create tables on first use and insert two demo patients when the table is empty.
AUTO_INIT_DB=true
SEED_DEMO_DATA=true

# Optional: when set, POST/PUT/DELETE /patients require the X-API-Key header.
# Leave empty during review so the API is open.
API_KEY=

# Optional but recommended: shared secret Vapi sends in the x-vapi-secret header.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_WEBHOOK_SECRET=

# Persona used in the voice prompt
CLINIC_NAME=Riverside Family Clinic
AGENT_NAME=Riley

# ---- Vapi provisioning (scripts/vapi_setup.py) ----------------------------
# Private key from Vapi Dashboard -> Vapi API Keys
VAPI_API_KEY=
# Public HTTPS URL of this backend (your Vercel deployment URL, e.g. https://your-app.vercel.app)
PUBLIC_BASE_URL=
# Desired US area code for the free Vapi number
VAPI_AREA_CODE=415
# LLM / voice choices (cheap, low-latency defaults)
VAPI_MODEL=gpt-4.1-mini
VAPI_VOICE_PROVIDER=deepgram
VAPI_VOICE_ID=thalia
# "true" = Deepgram multilingual transcription (English + Spanish code-switching)
VAPI_MULTILINGUAL=false
# Filled automatically into .vapi-state.json after the first run; set here to override.
# If you created the phone number in the Vapi dashboard instead, paste the number's ID
# (the UUID on its page, not the digits) into VAPI_PHONE_NUMBER_ID, or run with --skip-phone.
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

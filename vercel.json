{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "voice-patient-registration": {
      "root": ".",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "voice-patient-registration"
      }
    }
  ]
}
